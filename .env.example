# JAW ingestion configuration. Copy to .env and fill in as needed.
# All variables are prefixed JAW_ and are optional - sensible defaults apply.

# Semantic extraction LLM provider.
# JAW_LLM_PROVIDER=none disables semantic extraction entirely (default) - no network
# calls are made and SemanticExtractor.extract() returns an explicit
# ExtractionFailure(reason="no_provider_configured") for every evidence item.
#
# Set JAW_LLM_PROVIDER=openai_compatible to enable it against any server implementing
# the OpenAI chat-completions HTTP contract - OpenAI itself, Groq, Anthropic via an
# OpenAI-compatible gateway, or a local Ollama/vLLM endpoint.
JAW_LLM_PROVIDER=none
JAW_LLM_BASE_URL=https://api.openai.com/v1
JAW_LLM_API_KEY=
JAW_LLM_MODEL=gpt-4o-mini
JAW_LLM_TIMEOUT=30
